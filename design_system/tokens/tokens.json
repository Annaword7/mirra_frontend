{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Mirra design tokens — derived from the Flutter implementation (mi_r_r_a_dev v2.4.0+102). Values seeded from existing UI to preserve visual identity.",
  "color": {
    "$type": "color",
    "brand": {
      "primary":        { "$value": "#5C85D9", "$description": "Primary blue — CTAs, links, active" },
      "primaryVariant": { "$value": "#3B6FCC", "$description": "Pressed/hover primary" },
      "secondary":      { "$value": "#F2EBB4", "$description": "Cream accent" },
      "tertiary":       { "$value": "#F4CFBC", "$description": "Peach accent" }
    },
    "text": {
      "primary":   { "$value": "#1A1A1A" },
      "secondary": { "$value": "#6B6B6B", "$description": "Darkened from #929292 for WCAG AA" },
      "tertiary":  { "$value": "#555555" },
      "disabled":  { "$value": "#AFAFB0" },
      "onPrimary": { "$value": "#FFFFFF" }
    },
    "surface": {
      "default":    { "$value": "#FFFFFF" },
      "muted":      { "$value": "#F3F4F6" },
      "background":  { "$value": "#EBF0FC", "$description": "App background (blue tint)" },
      "backgroundRaised": { "$value": "#CBDDFE" }
    },
    "border": {
      "default": { "$value": "#E0E0E0" },
      "divider": { "$value": "#E6E6E6" }
    },
    "semantic": {
      "success":   { "$value": "#2E7D32" },
      "successBg": { "$value": "#E8F5E9" },
      "warning":   { "$value": "#F9A825" },
      "warningBg": { "$value": "#FFF3E0" },
      "error":     { "$value": "#E53935" },
      "errorBg":   { "$value": "#FFEBEE" },
      "info":      { "$value": "#5C85D9" }
    },
    "overlay": {
      "08": { "$value": "#00000014", "$description": "black @ 8%" },
      "10": { "$value": "#0000001A", "$description": "black @ 10%" },
      "20": { "$value": "#00000033", "$description": "black @ 20%" },
      "27": { "$value": "#00000044", "$description": "black @ 27% — scrim" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Raleway", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "displayLarge":   { "$value": { "fontFamily": "Raleway", "fontSize": "57px", "fontWeight": 400, "lineHeight": "1.1" } },
    "displayMedium":  { "$value": { "fontFamily": "Raleway", "fontSize": "45px", "fontWeight": 400, "lineHeight": "1.1" } },
    "displaySmall":   { "$value": { "fontFamily": "Raleway", "fontSize": "36px", "fontWeight": 600, "lineHeight": "1.1" } },
    "headlineLarge":  { "$value": { "fontFamily": "Raleway", "fontSize": "32px", "fontWeight": 400, "lineHeight": "1.15" } },
    "headlineMedium": { "$value": { "fontFamily": "Raleway", "fontSize": "24px", "fontWeight": 500, "lineHeight": "1.2" } },
    "headlineSmall":  { "$value": { "fontFamily": "Raleway", "fontSize": "22px", "fontWeight": 700, "lineHeight": "1.2" } },
    "titleLarge":     { "$value": { "fontFamily": "Raleway", "fontSize": "20px", "fontWeight": 500, "lineHeight": "1.2" }, "$description": "Added: 20px was used 5x with no slot" },
    "titleMedium":    { "$value": { "fontFamily": "Raleway", "fontSize": "18px", "fontWeight": 500, "lineHeight": "1.3" } },
    "titleSmall":     { "$value": { "fontFamily": "Raleway", "fontSize": "16px", "fontWeight": 500, "lineHeight": "1.3" } },
    "bodyLarge":      { "$value": { "fontFamily": "Raleway", "fontSize": "16px", "fontWeight": 400, "lineHeight": "1.5" } },
    "bodyMedium":     { "$value": { "fontFamily": "Raleway", "fontSize": "14px", "fontWeight": 400, "lineHeight": "1.5" } },
    "bodySmall":      { "$value": { "fontFamily": "Raleway", "fontSize": "12px", "fontWeight": 400, "lineHeight": "1.4" } },
    "labelLarge":     { "$value": { "fontFamily": "Raleway", "fontSize": "16px", "fontWeight": 600, "lineHeight": "1.2" } },
    "labelMedium":    { "$value": { "fontFamily": "Raleway", "fontSize": "14px", "fontWeight": 500, "lineHeight": "1.2" } },
    "labelSmall":     { "$value": { "fontFamily": "Raleway", "fontSize": "12px", "fontWeight": 500, "lineHeight": "1.2" } }
  },
  "space": {
    "$type": "dimension",
    "xxs":  { "$value": "2px" },
    "xs":   { "$value": "4px" },
    "sm":   { "$value": "8px" },
    "md":   { "$value": "12px" },
    "lg":   { "$value": "16px" },
    "xl":   { "$value": "20px" },
    "2xl":  { "$value": "24px" },
    "3xl":  { "$value": "32px" },
    "4xl":  { "$value": "40px" },
    "5xl":  { "$value": "48px" },
    "6xl":  { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "xs":   { "$value": "4px" },
    "sm":   { "$value": "8px" },
    "md":   { "$value": "12px" },
    "lg":   { "$value": "16px" },
    "xl":   { "$value": "24px" },
    "2xl":  { "$value": "32px" },
    "full": { "$value": "9999px" }
  },
  "borderWidth": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "thick":    { "$value": "2px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": { "color": "#0000001A", "offsetX": "0px", "offsetY": "1px",  "blur": "3px",  "spread": "0px" } },
    "md": { "$value": { "color": "#0000001A", "offsetX": "0px", "offsetY": "3px",  "blur": "6px",  "spread": "0px" } },
    "lg": { "$value": { "color": "#0000001A", "offsetX": "0px", "offsetY": "8px",  "blur": "15px", "spread": "0px" } },
    "xl": { "$value": { "color": "#0000001A", "offsetX": "0px", "offsetY": "16px", "blur": "25px", "spread": "0px" } }
  },
  "opacity": {
    "$type": "number",
    "0":  { "$value": 0 },
    "04": { "$value": 0.04 },
    "08": { "$value": 0.08 },
    "12": { "$value": 0.12 },
    "16": { "$value": 0.16 },
    "24": { "$value": 0.24 },
    "32": { "$value": 0.32 },
    "48": { "$value": 0.48 },
    "64": { "$value": 0.64 },
    "80": { "$value": 0.80 },
    "92": { "$value": 0.92 }
  },
  "size": {
    "$type": "dimension",
    "icon":   { "xs": { "$value": "16px" }, "sm": { "$value": "20px" }, "md": { "$value": "24px" }, "lg": { "$value": "28px" }, "xl": { "$value": "32px" }, "2xl": { "$value": "48px" } },
    "button": { "sm": { "$value": "36px" }, "md": { "$value": "44px" }, "lg": { "$value": "52px" } },
    "input":  { "default": { "$value": "52px" } },
    "avatar": { "xs": { "$value": "24px" }, "sm": { "$value": "32px" }, "md": { "$value": "40px" }, "lg": { "$value": "56px" }, "xl": { "$value": "80px" } },
    "blur":   { "backdrop": { "$value": "18px" } }
  }
}
